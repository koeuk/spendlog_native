# Where the SpendLog API lives. Leave unset in development: the app derives the
# host from the Metro bundler (your PC on the LAN, 10.0.2.2 on the Android emulator).
# EXPO_PUBLIC_API_URL=https://spendlog.example.com/api/v1

# The port `php artisan serve` is on. Only used when EXPO_PUBLIC_API_URL is unset.
EXPO_PUBLIC_API_PORT=8000
